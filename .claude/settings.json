{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__pixellab__generate_image_pixflux|mcp__pixellab__generate_image_bitforge|mcp__pixellab__animate_with_text|mcp__pixellab__rotate",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-pixellab-creation.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-reminder.sh\""
          }
        ]
      }
    ]
  }
}
